# Copy to .env, then replace ALL placeholders. Never commit .env.
INSTANCE_CONNECTION_NAME=YOUR_PROJECT:asia-southeast1:waimea-postgres
DB_HOST=cloud-sql-proxy
DB_PORT=5432
DB_NAME=waimea_wavecast
DB_USER=waimea_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GCS_BUCKET=waimea-noaa
GCP_PROJECT_ID=YOUR_PROJECT
PUBLIC_ORIGIN=https://waimea.liems.io.vn
PUBLIC_API_HOST=apiwaimea.liems.io.vn
ENABLE_DOCS=false
# Configure these in a secret store/secured host env before implementing internal APIs:
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
ADMIN_API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# This template intentionally does not yet inject secrets into app code.
