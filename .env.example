# Local only. Postgres local can be started via Compose profile devdb.
POSTGRES_DB=waimea_wavecast
POSTGRES_USER=waimea
POSTGRES_PASSWORD=change-me
NOAA_STATION_ID=51201
CDIP_STATION_ID=106
WAIMEA_LAT=21.671
WAIMEA_LON=-158.118
POLL_INTERVAL_SECONDS=1800
ALLOWED_ORIGINS=http://localhost:5173
GCS_BUCKET=waimea-noaa
GCS_RAW_BUCKET=waimea-noaa
GCS_MODELS_BUCKET=waimea-noaa
GCS_BACKUP_BUCKET=waimea-noaa
HISTORY_METADATA_CHECK_HOURS=24
HISTORY_FULL_CHECK_DAYS=30
HISTORY_MAX_FILES_PER_RUN=1

# TL01 Database API (set local secrets only in .env)
DB_HOST=postgres-local
DB_PORT=5432
DB_NAME=waimea_wavecast
DB_USER=waimea
DB_PASSWORD=change-me
DB_SSLMODE=disable
INTERNAL_API_TOKEN=replace-with-random-token
ADMIN_API_TOKEN=replace-with-different-random-token
APP_ENV=development
INGESTION_ADAPTER_MODE=disabled
PUBLIC_ORIGIN=http://localhost:5173
DEMO_DELETE_ENABLED=false
DEMO_BACKUP_CONFIRMED=false

# TL05 worker connections and immutable model storage
DATABASE_API_URL=http://database-api:8000
INGESTION_WORKER_URL=http://ingestion:8000
PREPROCESSING_WORKER_URL=http://preprocessing:8000
AUTO_IMPUTATION_ENABLED=false
NOAA_MAX_RETRIES=0
