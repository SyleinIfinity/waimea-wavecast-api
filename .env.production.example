# Populate securely on the VM; NEVER commit the real file.
NOAA_STATION_ID=51201
CDIP_STATION_ID=106
WAIMEA_LAT=21.671
WAIMEA_LON=-158.118
POLL_INTERVAL_SECONDS=1800
# Comma-separated browser origins. Add localhost:5173 only while using local frontend.
ALLOWED_ORIGINS=https://waimea.liems.io.vn,http://localhost:5173
GCS_BUCKET=waimea-noaa
GCS_RAW_BUCKET=waimea-noaa
GCS_MODELS_BUCKET=waimea-noaa
GCS_BACKUP_BUCKET=waimea-noaa
# HTTPS_PROXY only when an approved outbound proxy is required.

# TL01 Database API; direct PostgreSQL connection from the VM
DB_HOST=dbwaimea.liems.io.vn
DB_PORT=5432
DB_NAME=waimea_wavecast
DB_USER=APP_USER
DB_PASSWORD=REPLACE_IN_PROTECTED_ENV_FILE
DB_SSLMODE=require
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
ADMIN_API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
APP_ENV=production
INGESTION_ADAPTER_MODE=real
PUBLIC_ORIGIN=https://waimea.liems.io.vn
DEMO_DELETE_ENABLED=false
DEMO_BACKUP_CONFIRMED=false

# TL05 internal worker connection
DATABASE_API_URL=http://database-api:8000
INGESTION_WORKER_URL=http://ingestion:8000
PREPROCESSING_WORKER_URL=http://preprocessing:8000
AUTO_IMPUTATION_ENABLED=false
NOAA_MAX_RETRIES=0
