# Populate securely on the VM; NEVER commit the real file.
CLOUD_SQL_INSTANCE_CONNECTION_NAME=PROJECT_ID:asia-southeast1:waimea-postgres
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@cloud-sql-proxy:5432/waimea_wavecast
NOAA_STATION_ID=51201
CDIP_STATION_ID=106
WAIMEA_LAT=21.671
WAIMEA_LON=-158.118
POLL_INTERVAL_SECONDS=1800
ALLOWED_ORIGINS=https://waimea.liems.io.vn
GCS_RAW_BUCKET=waimea-raw-PROJECT_ID
GCS_MODELS_BUCKET=waimea-models-PROJECT_ID
GCS_BACKUP_BUCKET=waimea-backups-PROJECT_ID
# HTTPS_PROXY only when an approved outbound proxy is required.

# TL01 Database API; Cloud SQL Proxy host for production Compose
DB_HOST=cloud-sql-proxy
DB_PORT=5432
DB_NAME=waimea_wavecast
DB_USER=APP_USER
DB_PASSWORD=REPLACE_IN_PROTECTED_ENV_FILE
DB_SSLMODE=disable
INTERNAL_API_TOKEN=REPLACE_WITH_RANDOM_SECRET
ADMIN_API_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
APP_ENV=production
PUBLIC_ORIGIN=https://waimea.liems.io.vn
DEMO_DELETE_ENABLED=false
DEMO_BACKUP_CONFIRMED=false

# TL05 internal worker connection
DATABASE_API_URL=http://database-api:8000
