[Unit]
Description=Waimea Calisthenics 1.5 forward-issued shadow forecasts and QC evaluation
Wants=network-online.target
After=network-online.target docker.service waimea-wavecast-api.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/mcadmin/projects/waimea-wavecast-api
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.yaml -f deploy/compose.prod.yaml --profile calisthenics run --rm --no-deps calisthenics-shadow
TimeoutStartSec=300
