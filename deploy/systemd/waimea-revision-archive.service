[Unit]
Description=Waimea verified monthly revision snapshot archive
After=network-online.target docker.service waimea-wavecast-api.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/mcadmin/projects/waimea-wavecast-api
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.yaml -f deploy/compose.prod.yaml --profile archive run --rm --no-deps revision-archive
TimeoutStartSec=3600
